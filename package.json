{
  "name": "kawn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "See the whole city.",
  "scripts": {
    "prepare:assets": "node scripts/prepare.mjs",
    "predev": "node scripts/prepare.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare.mjs && node scripts/check-brand.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "serve": "npm run build && node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "brand": "node scripts/generate-brand.mjs",
    "check:brand": "node scripts/check-brand.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "cesium": "^1.146.0",
    "satellite.js": "^6.0.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
